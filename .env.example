# Optional. The app works in deterministic demo mode without a key.
# Server-only. Never prefix this with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
# Optional, default claude-sonnet-5-5 (Claude Sonnet 5.5).
ANTHROPIC_MODEL=claude-sonnet-5-5

# Supabase Auth. The publishable key is meant for the browser.
# Never put the service-role or secret key in this file, and never prefix a secret with NEXT_PUBLIC_.
# This app does not read a service-role key. Row Level Security is what keeps rows private.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Legacy name, used only when NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY is empty.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
